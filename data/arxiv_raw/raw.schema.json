{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://57cx.github.io/robot-grasp-papers/data/arxiv_raw/raw.schema.json",
  "title": "ArxivRawCandidates",
  "description": "GitHub Actions 从公开 arXiv API 抓取的未解读候选。summary 是英文原文，不是中文解读。",
  "type": "object",
  "additionalProperties": true,
  "required": ["date", "fetched_at", "source", "source_query", "count", "items"],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "timezone": { "const": "Asia/Shanghai" },
    "fetched_at": { "type": "string" },
    "source": { "type": "string" },
    "source_query": { "type": "string" },
    "api_query": { "type": "string" },
    "window_start": { "type": "string" },
    "window_end": { "type": "string" },
    "lookback_days": { "type": "integer" },
    "status": { "const": "uninterpreted_candidates" },
    "count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "arxiv_id",
        "title",
        "authors",
        "summary",
        "published",
        "updated",
        "categories",
        "primary_category",
        "arxiv_url",
        "pdf_url",
        "matched_keywords"
      ],
      "properties": {
        "arxiv_id": { "type": "string" },
        "title": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string", "description": "arXiv 英文摘要原文。" },
        "published": { "type": "string" },
        "updated": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "primary_category": { "type": "string" },
        "arxiv_url": { "type": "string" },
        "pdf_url": { "type": "string" },
        "matched_keywords": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
